rules_version = '2';

// EduMate Pro Cloud Storage rules.
service firebase.storage {
  match /b/{bucket}/o {

    // Enrollment application documents (birth certificate, reports, …):
    // only the applying parent writes into their own folder; any signed-in
    // user with the download URL can read (admin reviews documents via the
    // tokened URLs stored on the application).
    match /applications/{uid}/{applicationId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Proof-of-payment uploads: the parent writes into their own folder.
    match /paymentProofs/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Homework worksheets set by teachers, per school: any signed-in user
    // with the link may read (parents open them); writes require auth.
    match /homework/{schoolId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // Profile photos: owner writes their own, any signed-in user reads.
    match /profilePhotos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
