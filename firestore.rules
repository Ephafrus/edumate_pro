rules_version = '2';

// EduMate Pro Firestore security rules — multi-school.
//
// Shape:
//   users/{uid}                          global account (superAdmin flag)
//   schools/{schoolId}                   a school
//   schools/{schoolId}/members/{uid}     membership + role at that school
//   schools/{schoolId}/<everything else> that school's data
//   staffInvites/{id}                    phone + school + role, pre sign-in
//
// Authorisation is membership-based: a request may only touch a school's
// data if the caller has a member document there, and management actions
// require the admin or principal role at *that* school. A person can hold
// different roles at different schools; each is checked independently.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function myPhone() {
      return request.auth.token.phone_number;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isSuperAdmin() {
      return isSignedIn() && userDoc().superAdmin == true;
    }

    // ---- Membership helpers (scoped to one school) -------------------------
    function memberPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
    }
    function isMember(schoolId) {
      return isSignedIn() && exists(memberPath(schoolId));
    }
    function myRole(schoolId) {
      return get(memberPath(schoolId)).data.role;
    }
    // Admins and principals both run the school.
    function isManager(schoolId) {
      return isMember(schoolId) && myRole(schoolId) in ['admin', 'principal'];
    }
    function isStaff(schoolId) {
      return isMember(schoolId)
        && myRole(schoolId) in ['admin', 'principal', 'teacher'];
    }
    function isParentAt(schoolId) {
      return isMember(schoolId) && myRole(schoolId) == 'parent';
    }

    // ---- Global accounts ---------------------------------------------------
    // A user creates and maintains their own record and can never grant
    // themselves platform powers. Super Admins may read anyone (to assign
    // them to a school) and promote other Super Admins.
    match /users/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin();
      allow create: if isSelf(uid)
                    && request.resource.data.get('superAdmin', false) == false;
      allow update: if isSuperAdmin()
                    || (isSelf(uid)
                        && request.resource.data.get('superAdmin', false)
                            == resource.data.get('superAdmin', false));
      allow delete: if isSuperAdmin();
    }

    // ---- Schools -----------------------------------------------------------
    // Any signed-in user may read the school list (parents choose one to
    // join); only Super Admins create or change schools.
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();

      // ---- Membership ------------------------------------------------------
      // Readable by the school's staff (directory) and by the person the
      // membership belongs to. A parent may join a school themselves; only a
      // manager or Super Admin may grant a staff role.
      match /members/{uid} {
        allow read: if isSuperAdmin()
                    || isSelf(uid)
                    || isStaff(schoolId);
        allow create: if isSuperAdmin()
                      || isManager(schoolId)
                      || (isSelf(uid)
                          && request.resource.data.role == 'parent');
        allow update: if isSuperAdmin()
                      || isManager(schoolId)
                      || (isSelf(uid)
                          && request.resource.data.role == resource.data.role);
        allow delete: if isSuperAdmin() || isManager(schoolId);
      }

      // ---- Classes & subjects ---------------------------------------------
      match /classes/{id} {
        allow read: if isMember(schoolId);
        allow write: if isManager(schoolId);
      }
      match /subjects/{id} {
        allow read: if isMember(schoolId);
        allow write: if isManager(schoolId);
      }

      // ---- Learners --------------------------------------------------------
      // Staff see every learner; a parent sees only their own children.
      // Any staff member may stamp the live attendance fields (QR scans).
      match /learners/{id} {
        allow read: if isStaff(schoolId)
                    || (isSignedIn()
                        && request.auth.uid in resource.data.parentUids);
        allow create, delete: if isManager(schoolId);
        allow update: if isManager(schoolId)
                    || (isStaff(schoolId)
                        && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['attendanceStatus', 'lastAttendanceAt']));
      }

      // ---- QR attendance ---------------------------------------------------
      match /attendance/{id} {
        allow read: if isStaff(schoolId)
                    || (isSignedIn()
                        && request.auth.uid in resource.data.parentUids);
        allow create: if isStaff(schoolId)
                    && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if isManager(schoolId);
      }

      // ---- Assessments & marks ---------------------------------------------
      // Teachers capture marks for the subjects they teach; managers see and
      // manage everything; parents read their own children's marks.
      match /assessments/{id} {
        allow read: if isStaff(schoolId);
        allow create, update: if isStaff(schoolId);
        allow delete: if isManager(schoolId)
                    || (isStaff(schoolId)
                        && resource.data.createdByUid == request.auth.uid);
      }
      match /marks/{id} {
        allow read: if isStaff(schoolId)
                    || (isSignedIn()
                        && request.auth.uid in resource.data.parentUids);
        allow create, update: if isStaff(schoolId);
        allow delete: if isManager(schoolId);
      }

      // ---- Lesson plans & homework ------------------------------------------
      // Published to the class: staff write, and members read (parents see
      // what their children are doing).
      match /lessonPlans/{id} {
        allow read: if isMember(schoolId);
        allow create, update: if isStaff(schoolId);
        allow delete: if isManager(schoolId)
                    || (isStaff(schoolId)
                        && resource.data.teacherUid == request.auth.uid);
      }
      match /homework/{id} {
        allow read: if isMember(schoolId);
        allow create, update: if isStaff(schoolId);
        allow delete: if isManager(schoolId)
                    || (isStaff(schoolId)
                        && resource.data.teacherUid == request.auth.uid);
      }

      // ---- Enrollment applications ------------------------------------------
      // A parent owns their application while it is a draft; once submitted,
      // only staff move it through the pipeline.
      match /applications/{id} {
        allow read: if isStaff(schoolId)
                    || (isSignedIn()
                        && resource.data.parentUid == request.auth.uid);
        allow create: if isParentAt(schoolId)
                    && request.resource.data.parentUid == request.auth.uid
                    && request.resource.data.status == 'draft';
        allow update: if isManager(schoolId)
                    || (isSignedIn()
                        && resource.data.parentUid == request.auth.uid
                        && resource.data.status == 'draft'
                        && request.resource.data.status in ['draft', 'submitted']);
        allow delete: if isManager(schoolId)
                    || (isSignedIn()
                        && resource.data.parentUid == request.auth.uid
                        && resource.data.status == 'draft');
      }

      // ---- Payments & fees ---------------------------------------------------
      match /payments/{id} {
        allow read: if isManager(schoolId)
                    || (isSignedIn()
                        && resource.data.parentUid == request.auth.uid);
        allow create: if isManager(schoolId)
                    || (isParentAt(schoolId)
                        && request.resource.data.parentUid == request.auth.uid
                        && request.resource.data.status == 'pending');
        allow update, delete: if isManager(schoolId);
      }
      match /feeStructures/{id} {
        allow read: if isMember(schoolId);
        allow write: if isManager(schoolId);
      }
      match /paymentImports/{id} {
        allow read, write: if isManager(schoolId);
      }

      // ---- School settings (SMTP email, …) ------------------------------------
      match /settings/{doc} {
        allow read: if isStaff(schoolId);
        allow write: if isManager(schoolId);
      }

      // ---- Broadcast messages -------------------------------------------------
      match /broadcasts/{id} {
        allow read: if isStaff(schoolId)
                    || (isSignedIn()
                        && request.auth.uid in resource.data.recipientUids);
        allow create, update, delete: if isManager(schoolId);
      }

      // ---- Calendar events ----------------------------------------------------
      match /events/{id} {
        function teachesClass(classId) {
          return classId != null
            && get(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId))
                .data.teacherUid == request.auth.uid;
        }
        allow read: if isMember(schoolId);
        allow create: if isManager(schoolId)
                    || (isStaff(schoolId)
                        && request.resource.data.audience == 'schoolClass'
                        && teachesClass(request.resource.data.classId));
        allow update, delete: if isManager(schoolId)
                    || (isStaff(schoolId)
                        && resource.data.createdByUid == request.auth.uid);
      }

      // ---- Chat ----------------------------------------------------------------
      match /chats/{id} {
        function isParticipant() {
          return isSignedIn()
            && request.auth.uid in resource.data.participantUids;
        }
        allow read: if isManager(schoolId) || isParticipant();
        allow create: if isMember(schoolId)
                    && request.auth.uid in request.resource.data.participantUids
                    && (
                      (request.resource.data.type == 'staff'
                       && isStaff(schoolId))
                      || (request.resource.data.type == 'parentTeacher'
                          && request.resource.data.approval == 'requested')
                    );
        allow update: if isManager(schoolId)
                    || (isParticipant()
                        && request.resource.data.approval == resource.data.approval
                        && request.resource.data.participantUids
                            == resource.data.participantUids);
        allow delete: if isManager(schoolId);

        match /messages/{msgId} {
          function thread() {
            return get(/databases/$(database)/documents/schools/$(schoolId)/chats/$(id)).data;
          }
          allow read: if isSignedIn()
                      && (request.auth.uid in thread().participantUids
                          || isManager(schoolId));
          allow create: if isSignedIn()
                      && request.resource.data.senderUid == request.auth.uid
                      && request.auth.uid in thread().participantUids
                      && thread().approval == 'approved';
          allow update, delete: if false;
        }
      }

      // ---- Outgoing mail audit trail / outbox ----------------------------------
      match /mailQueue/{id} {
        allow read: if isStaff(schoolId);
        allow create, update: if isStaff(schoolId);
        allow delete: if isManager(schoolId);
      }
    }

    // ---- Collection-group read of memberships --------------------------------
    // Lets a user list *all* the schools they belong to in one query, which is
    // what powers the school switcher. Constrained to their own uid.
    match /{path=**}/members/{uid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Staff invites ---------------------------------------------------------
    // Created by a Super Admin (school admins/principals) or a school manager
    // (teachers). The invitee may read and claim invites for their own verified
    // phone number at first sign-in.
    match /staffInvites/{id} {
      allow read: if isSuperAdmin()
                  || (isSignedIn() && resource.data.phone == myPhone())
                  || (isSignedIn() && isManager(resource.data.schoolId));
      allow create: if isSuperAdmin()
                  || isManager(request.resource.data.schoolId);
      allow update: if isSuperAdmin()
                  || isManager(resource.data.schoolId)
                  || (isSignedIn()
                      && resource.data.phone == myPhone()
                      && request.resource.data.claimedByUid == request.auth.uid);
      allow delete: if isSuperAdmin() || isManager(resource.data.schoolId);
    }
  }
}
