rules_version = '2';

// EduMate Pro Firestore security rules.
// Roles live on the user record: users/{uid}.role in {admin, teacher, parent}.
// Everyone authenticates with Firebase Phone Auth, so request.auth.token
// carries the verified phone_number used to match staff invites.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myRole() {
      return me().role;
    }
    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }
    function isStaff() {
      return isSignedIn() && myRole() in ['admin', 'teacher'];
    }
    function myPhone() {
      return request.auth.token.phone_number;
    }
    function hasInvite() {
      return myPhone() != null
        && exists(/databases/$(database)/documents/staffInvites/$(myPhone()));
    }
    function inviteData() {
      return get(/databases/$(database)/documents/staffInvites/$(myPhone())).data;
    }

    // ---- Accounts ----------------------------------------------------------
    // Self-creation on first sign-in: parents by default; a staff role is
    // only allowed when an unclaimed invite for the verified phone number
    // grants it. Users can never escalate their own role afterwards.
    match /users/{uid} {
      allow read: if isSelf(uid)
                  || isStaff()
                  // Parents may list teachers (to request a chat).
                  || (isSignedIn() && resource.data.role == 'teacher');
      allow create: if isSelf(uid)
                  && (request.resource.data.role == 'parent'
                      || (hasInvite()
                          && inviteData().claimedByUid == null
                          && request.resource.data.role == inviteData().role));
      allow update: if isAdmin()
                  || (isSelf(uid)
                      && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ---- Staff invites (doc id = E.164 phone number) ----------------------
    // Admin manages invites; the invited phone may read its own invite and
    // mark it claimed (with their own uid) during first sign-in.
    match /staffInvites/{phone} {
      allow read: if isAdmin() || (isSignedIn() && phone == myPhone());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                  || (isSignedIn()
                      && phone == myPhone()
                      && request.resource.data.claimedByUid == request.auth.uid);
    }

    // ---- Classes -----------------------------------------------------------
    match /classes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Learners ----------------------------------------------------------
    // Staff see all learners; a parent sees only learners linked to them.
    match /learners/{id} {
      allow read: if isStaff()
                  || (isSignedIn()
                      && request.auth.uid in resource.data.parentUids);
      allow write: if isAdmin();
    }

    // ---- Enrollment applications ------------------------------------------
    // A parent owns their application while it is a draft; once submitted,
    // only staff move it through the pipeline.
    match /applications/{id} {
      allow read: if isStaff()
                  || (isSignedIn() && resource.data.parentUid == request.auth.uid);
      allow create: if isSignedIn()
                  && request.resource.data.parentUid == request.auth.uid
                  && request.resource.data.status == 'draft';
      allow update: if isAdmin()
                  || (isSignedIn()
                      && resource.data.parentUid == request.auth.uid
                      && resource.data.status == 'draft'
                      && request.resource.data.status in ['draft', 'submitted']);
      allow delete: if isAdmin()
                  || (isSignedIn()
                      && resource.data.parentUid == request.auth.uid
                      && resource.data.status == 'draft');
    }

    // ---- Payments ----------------------------------------------------------
    // Parents submit (status pending); only admin reviews.
    match /payments/{id} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.parentUid == request.auth.uid);
      allow create: if isSignedIn()
                  && request.resource.data.parentUid == request.auth.uid
                  && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ---- Chat --------------------------------------------------------------
    // Staff chats are created approved by a staff participant. Parent-teacher
    // chats are created as approval requests by the parent; only an admin may
    // change the approval state. Participants may update thread metadata
    // (last message preview) but never the approval.
    match /chats/{id} {
      function isParticipant() {
        return isSignedIn()
          && request.auth.uid in resource.data.participantUids;
      }
      allow read: if isAdmin() || isParticipant();
      allow create: if isSignedIn()
                  && request.auth.uid in request.resource.data.participantUids
                  && (
                    (request.resource.data.type == 'staff'
                     && isStaff())
                    || (request.resource.data.type == 'parentTeacher'
                        && request.resource.data.approval == 'requested')
                  );
      allow update: if isAdmin()
                  || (isParticipant()
                      && request.resource.data.approval == resource.data.approval
                      && request.resource.data.participantUids
                          == resource.data.participantUids);
      allow delete: if isAdmin();

      // Messages: participants only, and only while the thread is approved.
      match /messages/{msgId} {
        function thread() {
          return get(/databases/$(database)/documents/chats/$(id)).data;
        }
        allow read: if isSignedIn()
                    && (request.auth.uid in thread().participantUids
                        || isAdmin());
        allow create: if isSignedIn()
                    && request.resource.data.senderUid == request.auth.uid
                    && request.auth.uid in thread().participantUids
                    && thread().approval == 'approved';
        allow update, delete: if false;
      }
    }

    // ---- Outgoing mail queue ----------------------------------------------
    // Cloud Functions (Admin SDK) bypass rules; from the client only admins
    // may queue custom notices, and nobody can tamper with queued mail.
    match /mailQueue/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
