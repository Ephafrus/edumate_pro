rules_version = '2';

// EduMate Pro Firestore security rules — multi-school.
//
// Shape:
//   users/{uid}                          global account (superAdmin flag)
//   schools/{schoolId}                   a school
//   schools/{schoolId}/members/{uid}     membership + role at that school
//   schools/{schoolId}/<everything else> that school's data
//   staffInvites/{id}                    phone + school + role, pre sign-in
//
// Authorisation is membership-based: a request may only touch a school's
// data if the caller has a member document there, and management actions
// require the admin or principal role at *that* school. A person can hold
// different roles at different schools; each is checked independently.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function myPhone() {
      return request.auth.token.phone_number;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function userDoc() {
      return get(userPath()).data;
    }
    // Guarded on existence: a signed-in caller whose user record has not been
    // written yet (or failed to write) would otherwise make this *error*
    // rather than return false, and an erroring clause muddies every rule
    // that starts with a Super Admin check.
    function isSuperAdmin() {
      return isSignedIn()
             && exists(userPath())
             && userDoc().get('superAdmin', false) == true;
    }

    // An invited staff member has to be able to write their *own* member
    // document on first sign-in — nobody else is there to do it for them.
    // Rules cannot run a query, only fetch a document by id, which is why
    // staff invites live at the derivable id `{schoolId}_{phoneE164}`: it
    // lets this check prove the caller really was invited, at this school,
    // in the role they are claiming. Without it a teacher's membership
    // write is refused and they fall back to being a parent.
    function invitePath(schoolId) {
      return /databases/$(database)/documents/staffInvites/$(schoolId + '_' + myPhone());
    }
    function inviteGrants(invite, schoolId) {
      return invite.phone == myPhone()
             && invite.schoolId == schoolId
             && invite.role == request.resource.data.role;
    }
    function claimsOwnStaffInvite(schoolId) {
      return isSignedIn()
             && request.auth.token.phone_number != null
             && exists(invitePath(schoolId))
             && inviteGrants(get(invitePath(schoolId)).data, schoolId);
    }

    // ---- Membership helpers (scoped to one school) -------------------------
    function memberPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
    }
    // A Super Admin oversees every school, so they satisfy the membership
    // checks everywhere without holding a member document. Without this,
    // signing in to a school for oversight would be denied on every read.
    function isMember(schoolId) {
      return isSignedIn() && (isSuperAdmin() || exists(memberPath(schoolId)));
    }
    function myRole(schoolId) {
      return get(memberPath(schoolId)).data.role;
    }
    // Admins and principals both run the school.
    function isManager(schoolId) {
      return isSignedIn()
        && (isSuperAdmin()
            || (exists(memberPath(schoolId))
                && myRole(schoolId) in ['admin', 'principal']));
    }
    function isStaff(schoolId) {
      return isSignedIn()
        && (isSuperAdmin()
            || (exists(memberPath(schoolId))
                && myRole(schoolId) in ['admin', 'principal', 'teacher']));
    }
    function isParentAt(schoolId) {
      return isSignedIn()
        && exists(memberPath(schoolId))
        && myRole(schoolId) == 'parent';
    }

    // ---- Global accounts ---------------------------------------------------
    // A user creates and maintains their own record and can never grant
    // themselves platform powers. Super Admins may read anyone (to assign
    // them to a school) and promote other Super Admins.
    // The platform-claim doc. A `create` fails if it already exists, so
    // exactly one user can ever claim a fresh deployment.
    match /platform/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.firstSuperAdminUid
                        == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin();
      // Normally nobody may make themselves a Super Admin. The one
      // exception is the very first user on an empty deployment, who has
      // just claimed `platform/config` — otherwise a fresh install would
      // have nobody able to create schools.
      allow create: if isSelf(uid)
                    && (request.resource.data.get('superAdmin', false) == false
                        || get(/databases/$(database)/documents/platform/config)
                             .data.firstSuperAdminUid == request.auth.uid);
      // Self-promotion is refused, with one exception mirroring create:
      // the user who holds the platform claim. That covers an account
      // created before the platform was ever claimed.
      allow update: if isSuperAdmin()
                    || (isSelf(uid)
                        && request.resource.data.get('superAdmin', false)
                            == resource.data.get('superAdmin', false))
                    || (isSelf(uid)
                        && exists(/databases/$(database)/documents/platform/config)
                        && get(/databases/$(database)/documents/platform/config)
                             .data.firstSuperAdminUid == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // ---- Schools -----------------------------------------------------------
    // Any signed-in user may read the school list (parents choose one to
    // join); only Super Admins create or change schools.
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create, delete: if isSuperAdmin();
      // A school's own admin or principal maintains its identity — name,
      // contact details, motto and logo. Deliberately **not** `active`:
      // suspending a school is the platform's decision, and a school must
      // not be able to un-suspend itself.
      allow update: if isSuperAdmin()
                    || (isManager(schoolId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['name', 'address', 'phone', 'email',
                                       'motto', 'logoUrl']));

      // ---- Membership ------------------------------------------------------
      // Readable by the school's staff (directory) and by the person the
      // membership belongs to. A parent may join a school themselves; only a
      // manager or Super Admin may grant a staff role.
      match /members/{uid} {
        allow read: if isSuperAdmin()
                    || isSelf(uid)
                    || isStaff(schoolId);
        allow create: if isSuperAdmin()
                      || isManager(schoolId)
                      || (isSelf(uid)
                          && request.resource.data.role == 'parent')
                      || (isSelf(uid) && claimsOwnStaffInvite(schoolId));
        allow update: if isSuperAdmin()
                      || isManager(schoolId)
                      || (isSelf(uid)
                          && request.resource.data.role == resource.data.role)
                      || (isSelf(uid) && claimsOwnStaffInvite(schoolId));
        allow delete: if isSuperAdmin() || isManager(schoolId);
      }

      // ---- Classes & subjects ---------------------------------------------
      // Managers own these. The one exception is completing a teaching link
      // that was made against a staff invite: on the invitee's first sign-in
      // the app swaps the invite id for their real uid, which they must be
      // able to write themselves. It is allowed only on the record that
      // carries *their* invite.
      function claimsOwnTeachingInvite() {
        return isSignedIn()
               && resource.data.teacherInviteId != null
               && request.resource.data.teacherUid == request.auth.uid
               && request.resource.data.teacherInviteId == null
               && exists(/databases/$(database)/documents/staffInvites/$(resource.data.teacherInviteId))
               && get(/databases/$(database)/documents/staffInvites/$(resource.data.teacherInviteId))
                    .data.claimedByUid == request.auth.uid;
      }
      match /classes/{id} {
        allow read: if isMember(schoolId);
        allow create, delete: if isManager(schoolId);
        allow update: if isManager(schoolId) || claimsOwnTeachingInvite();
      }
      match /subjects/{id} {
        allow read: if isMember(schoolId);
        allow create, delete: if isManager(schoolId);
        allow update: if isManager(schoolId) || claimsOwnTeachingInvite();
      }

      // ---- Learners --------------------------------------------------------
      // Staff see every learner; a parent sees only their own children.
      // Any staff member may stamp the live attendance fields (QR scans).
      match /learners/{id} {
        allow read: if isStaff(schoolId)
                    || (isSignedIn()
                        && request.auth.uid in resource.data.parentUids);
        allow create, delete: if isManager(schoolId);
        allow update: if isManager(schoolId)
                    || (isStaff(schoolId)
                        && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['attendanceStatus', 'lastAttendanceAt']));
      }

      // ---- QR attendance ---------------------------------------------------
      match /attendance/{id} {
        allow read: if isStaff(schoolId)
                    || (isSignedIn()
                        && request.auth.uid in resource.data.parentUids);
        allow create: if isStaff(schoolId)
                    && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if isManager(schoolId);
      }

      // ---- Assessments & marks ---------------------------------------------
      // Teachers capture marks for the subjects they teach; managers see and
      // manage everything; parents read their own children's marks.
      match /assessments/{id} {
        allow read: if isStaff(schoolId);
        allow create, update: if isStaff(schoolId);
        allow delete: if isManager(schoolId)
                    || (isStaff(schoolId)
                        && resource.data.createdByUid == request.auth.uid);
      }
      match /marks/{id} {
        allow read: if isStaff(schoolId)
                    || (isSignedIn()
                        && request.auth.uid in resource.data.parentUids);
        allow create, update: if isStaff(schoolId);
        allow delete: if isManager(schoolId);
      }

      // ---- Lesson plans & homework ------------------------------------------
      // Published to the class: staff write, and members read (parents see
      // what their children are doing).
      match /lessonPlans/{id} {
        allow read: if isMember(schoolId);
        allow create, update: if isStaff(schoolId);
        allow delete: if isManager(schoolId)
                    || (isStaff(schoolId)
                        && resource.data.teacherUid == request.auth.uid);
      }
      match /homework/{id} {
        allow read: if isMember(schoolId);
        allow create, update: if isStaff(schoolId);
        allow delete: if isManager(schoolId)
                    || (isStaff(schoolId)
                        && resource.data.teacherUid == request.auth.uid);
      }

      // ---- Enrollment applications ------------------------------------------
      // A parent owns their application while it is a draft; once submitted,
      // only staff move it through the pipeline.
      match /applications/{id} {
        allow read: if isStaff(schoolId)
                    || (isSignedIn()
                        && resource.data.parentUid == request.auth.uid);
        allow create: if isParentAt(schoolId)
                    && request.resource.data.parentUid == request.auth.uid
                    && request.resource.data.status == 'draft';
        allow update: if isManager(schoolId)
                    || (isSignedIn()
                        && resource.data.parentUid == request.auth.uid
                        && resource.data.status == 'draft'
                        && request.resource.data.status in ['draft', 'submitted']);
        allow delete: if isManager(schoolId)
                    || (isSignedIn()
                        && resource.data.parentUid == request.auth.uid
                        && resource.data.status == 'draft');

        // Review notes and messages. Staff see the whole thread; the
        // applicant only sees the entries addressed to them, which they can
        // never write or change.
        match /comments/{commentId} {
          function ownsApplication() {
            return isSignedIn()
                   && get(/databases/$(database)/documents/schools/$(schoolId)/applications/$(id))
                        .data.parentUid == request.auth.uid;
          }
          allow read: if isStaff(schoolId)
                      || (ownsApplication() && resource.data.internal == false);
          allow create: if isStaff(schoolId)
                      && request.resource.data.byUid == request.auth.uid;
          allow update, delete: if false;
        }
      }

      // ---- Payments & fees ---------------------------------------------------
      // Approving money is the principal's signature, so the rules enforce
      // it rather than trusting the UI to hide a button: an office admin can
      // record a receipt but it stays pending until the principal signs it
      // off. A principal recording one may write it approved directly.
      function approvesPayments(schoolId) {
        return isSignedIn()
               && (isSuperAdmin()
                   || (exists(memberPath(schoolId))
                       && myRole(schoolId) == 'principal'));
      }
      function paymentStaysPending() {
        return request.resource.data.status == 'pending';
      }
      match /payments/{id} {
        allow read: if isManager(schoolId)
                    || (isSignedIn()
                        && resource.data.parentUid == request.auth.uid);
        allow create: if approvesPayments(schoolId)
                    || (isManager(schoolId) && paymentStaysPending())
                    || (isParentAt(schoolId)
                        && request.resource.data.parentUid == request.auth.uid
                        && paymentStaysPending());
        // A manager may correct a pending payment's details; only the
        // principal may change what its status says.
        allow update: if approvesPayments(schoolId)
                    || (isManager(schoolId)
                        && request.resource.data.status == resource.data.status);
        allow delete: if isManager(schoolId);
      }
      match /feeStructures/{id} {
        allow read: if isMember(schoolId);
        allow write: if isManager(schoolId);
      }
      // Invoices are the school's charges. Staff raise them; a parent reads
      // only the ones raised against their own children.
      match /invoices/{id} {
        allow read: if isStaff(schoolId)
                    || (isSignedIn()
                        && request.auth.uid in resource.data.parentUids);
        allow write: if isManager(schoolId);
      }
      match /paymentImports/{id} {
        allow read, write: if isManager(schoolId);
      }

      // ---- School settings (SMTP email, …) ------------------------------------
      match /settings/{doc} {
        allow read: if isStaff(schoolId);
        allow write: if isManager(schoolId);
      }

      // ---- Broadcast messages -------------------------------------------------
      match /broadcasts/{id} {
        allow read: if isStaff(schoolId)
                    || (isSignedIn()
                        && request.auth.uid in resource.data.recipientUids);
        allow create, update, delete: if isManager(schoolId);
      }

      // ---- Calendar events ----------------------------------------------------
      match /events/{id} {
        function teachesClass(classId) {
          return classId != null
            && get(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId))
                .data.teacherUid == request.auth.uid;
        }
        allow read: if isMember(schoolId);
        allow create: if isManager(schoolId)
                    || (isStaff(schoolId)
                        && request.resource.data.audience == 'schoolClass'
                        && teachesClass(request.resource.data.classId));
        allow update, delete: if isManager(schoolId)
                    || (isStaff(schoolId)
                        && resource.data.createdByUid == request.auth.uid);
      }

      // ---- Chat ----------------------------------------------------------------
      match /chats/{id} {
        function isParticipant() {
          return isSignedIn()
            && request.auth.uid in resource.data.participantUids;
        }
        allow read: if isManager(schoolId) || isParticipant();
        allow create: if isMember(schoolId)
                    && request.auth.uid in request.resource.data.participantUids
                    && (
                      (request.resource.data.type == 'staff'
                       && isStaff(schoolId))
                      || (request.resource.data.type == 'parentTeacher'
                          && request.resource.data.approval == 'requested')
                    );
        allow update: if isManager(schoolId)
                    || (isParticipant()
                        && request.resource.data.approval == resource.data.approval
                        && request.resource.data.participantUids
                            == resource.data.participantUids);
        allow delete: if isManager(schoolId);

        match /messages/{msgId} {
          function thread() {
            return get(/databases/$(database)/documents/schools/$(schoolId)/chats/$(id)).data;
          }
          allow read: if isSignedIn()
                      && (request.auth.uid in thread().participantUids
                          || isManager(schoolId));
          allow create: if isSignedIn()
                      && request.resource.data.senderUid == request.auth.uid
                      && request.auth.uid in thread().participantUids
                      && thread().approval == 'approved';
          allow update, delete: if false;
        }
      }

      // ---- Outgoing mail audit trail / outbox ----------------------------------
      match /mailQueue/{id} {
        allow read: if isStaff(schoolId);
        allow create, update: if isStaff(schoolId);
        allow delete: if isManager(schoolId);
      }
    }

    // ---- Collection-group read of memberships --------------------------------
    // Lets a user list *all* the schools they belong to in one query, which is
    // what powers the school switcher. Constrained to their own uid.
    match /{path=**}/members/{uid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- System activity log ---------------------------------------------------
    // Append-only audit trail. Anyone signed in records their own actions;
    // only a Super Admin can read the feed; nobody may edit or delete an
    // entry, so the trail cannot be tampered with.
    match /activityLogs/{id} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Staff invites ---------------------------------------------------------
    // Created by a Super Admin (school admins/principals) or a school manager
    // (teachers). The invitee may read and claim invites for their own verified
    // phone number at first sign-in.
    match /staffInvites/{id} {
      allow read: if isSuperAdmin()
                  || (isSignedIn() && resource.data.phone == myPhone())
                  || (isSignedIn() && isManager(resource.data.schoolId));
      allow create: if isSuperAdmin()
                  || isManager(request.resource.data.schoolId);
      allow update: if isSuperAdmin()
                  || isManager(resource.data.schoolId)
                  || (isSignedIn()
                      && resource.data.phone == myPhone()
                      && request.resource.data.claimedByUid == request.auth.uid);
      allow delete: if isSuperAdmin() || isManager(resource.data.schoolId);
    }
  }
}
